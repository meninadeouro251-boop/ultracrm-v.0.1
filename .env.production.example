# =============================================================================
# Ultra CRM SaaS — Production Environment Configuration Example
# =============================================================================
# Copy this file to .env for production deployment:
#   cp .env.production.example .env
#
# IMPORTANT: All values marked as CHANGE_ME_REQUIRED must be updated with
# secure, randomly generated strings before starting the application.
# =============================================================================

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres.production.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USERNAME=ultra_app
POSTGRES_PASSWORD=CHANGE_ME_REQUIRED_SECURE_DB_PASSWORD
POSTGRES_DATABASE=ultra_production

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://:CHANGE_ME_REQUIRED_SECURE_REDIS_PASS@redis.production.svc.cluster.local:6379
REDIS_PASSWORD=CHANGE_ME_REQUIRED_SECURE_REDIS_PASS

# =============================================================================
# SHARED SECRETS
# =============================================================================
# Use 'openssl rand -hex 64' to generate these
SECRET_KEY_BASE=CHANGE_ME_REQUIRED_HEX_64
JWT_SECRET_KEY=CHANGE_ME_REQUIRED_HEX_64

# Used for API key encryption — use 'openssl rand -base64 32'
ENCRYPTION_KEY=CHANGE_ME_REQUIRED_BASE64_32

# Service-to-service authentication — use 'uuidgen'
ULTRA_CRM_API_TOKEN=CHANGE_ME_REQUIRED_UUID

# =============================================================================
# AUTH SERVICE — Port 3001
# =============================================================================
RAILS_ENV=production
RAILS_MAX_THREADS=25
RAILS_SERVE_STATIC_FILES=true
FRONTEND_URL=https://app.ultracrm.com

# Doorkeeper JWT
DOORKEEPER_JWT_SECRET_KEY=CHANGE_ME_REQUIRED_HEX_64
DOORKEEPER_JWT_ALGORITHM=hs256
DOORKEEPER_JWT_ISS=https://auth.ultracrm.com
DOORKEEPER_JWT_AUD=[]

MFA_ISSUER=Ultra CRM
MAILER_SENDER_EMAIL=noreply@ultracrm.com

# SMTP Production Config
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_DOMAIN=ultracrm.com
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=apikey
SMTP_PASSWORD=CHANGE_ME_REQUIRED_SMTP_PASS

# Storage (S3 recommended for production)
ACTIVE_STORAGE_SERVICE=amazon
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET=

# =============================================================================
# CRM SERVICE — Port 3000
# =============================================================================
BACKEND_URL=https://api.ultracrm.com
ULTRA_AI_CORE_SERVICE_URL=http://ultra-core:5555
ULTRA_AUTH_SERVICE_URL=http://ultra-auth:3001

# CORS — STRICTLY CONFIGURE THESE
CORS_ORIGINS=https://app.ultracrm.com,https://api.ultracrm.com

DISABLE_TELEMETRY=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=warn

# =============================================================================
# CORE SERVICE — Port 5555
# =============================================================================
DB_HOST=postgres.production.svc.cluster.local
DB_SSLMODE=require
JWT_ALGORITHM=HS256

ULTRA_AUTH_BASE_URL=http://ultra-auth:3001
AI_PROCESSOR_URL=http://ultra-processor:8000
AI_PROCESSOR_VERSION=v1

# =============================================================================
# PROCESSOR SERVICE — Port 8000
# =============================================================================
POSTGRES_CONNECTION_STRING=postgresql://ultra_app:CHANGE_ME_REQUIRED_SECURE_DB_PASSWORD@postgres.production.svc.cluster.local:5432/ultra_production
DEBUG=false
CORE_SERVICE_URL=http://ultra-core:5555/api/v1

# =============================================================================
# BOT RUNTIME — Port 8080
# =============================================================================
BOT_RUNTIME_SECRET=CHANGE_ME_REQUIRED_SECURE_BOT_SECRET
AI_PROCESSOR_API_KEY=CHANGE_ME_REQUIRED_SECURE_PROCESSOR_KEY

# =============================================================================
# FRONTEND — Port 5173
# =============================================================================
VITE_APP_ENV=production
VITE_API_URL=https://api.ultracrm.com
VITE_AUTH_API_URL=https://auth.ultracrm.com
VITE_ULTRA_API_URL=https://core.ultracrm.com
VITE_AGENT_PROCESSOR_URL=https://processor.ultracrm.com
